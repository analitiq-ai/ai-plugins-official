{
  "x-comment": "Reference example, not normative. Models Snowflake via SQLAlchemy with account/warehouse/role connection params.",
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "alias": "snowflake-example",
  "display_name": "Snowflake Example",
  "description": "Reference connector for Snowflake using the snowflake driver.",
  "tags": [
    "example",
    "database",
    "snowflake",
    "warehouse"
  ],
  "version": "1.0.0",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "sqlalchemy",
      "driver": "snowflake",
      "dsn": {
        "kind": "url_template",
        "template": "snowflake://{username}:{password}@{account}/{database}/{schema}?warehouse={warehouse}&role={role}",
        "bindings": {
          "username": {
            "value": {
              "ref": "connection.parameters.username"
            },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": {
              "ref": "secrets.password"
            },
            "encoding": "url_userinfo"
          },
          "account": {
            "value": {
              "ref": "connection.parameters.account"
            },
            "encoding": "host"
          },
          "database": {
            "value": {
              "ref": "connection.parameters.database"
            },
            "encoding": "url_path_segment"
          },
          "schema": {
            "value": {
              "ref": "connection.parameters.schema"
            },
            "encoding": "url_path_segment"
          },
          "warehouse": {
            "value": {
              "ref": "connection.parameters.warehouse"
            },
            "encoding": "url_query_value"
          },
          "role": {
            "value": {
              "ref": "connection.parameters.role"
            },
            "encoding": "url_query_value"
          }
        }
      }
    }
  },
  "auth": {
    "type": "db"
  },
  "connection_contract": {
    "inputs": {
      "account": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true
      },
      "schema": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "default": "PUBLIC"
      },
      "warehouse": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true
      },
      "role": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false
      },
      "username": {
        "source": "user",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true
      },
      "password": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true
      }
    }
  },
  "resource_discovery": {
    "strategy": "snowflake_account_usage",
    "transport_ref": "database",
    "implementation": {
      "type": "builtin"
    },
    "produces": [
      "connection.endpoints",
      "connection.type_map"
    ],
    "triggers": {
      "list_resources": "on_activation",
      "describe_resource": "on_resource_selected"
    }
  }
}
